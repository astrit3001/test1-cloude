  .lc-cfg__table td { padding: 10px 8px; border-bottom: 1px solid #efe9df; vertical-align: top; }
  .lc-cfg__table td small { display: block; color: #8a6a3a; font-size: 11px; }
  .lc-cfg__table td:last-child, .lc-cfg__table th:last-child { text-align: right; white-space: nowrap; }
  .lc-cfg__table tfoot td { font-weight: 700; font-size: 16px; border-bottom: 0; border-top: 2px solid #111; }
  .lc-cfg__note { font-size: 13px; color: #6f675c; margin: 0 0 16px; }
  .lc-cfg__photos { background: #f7f4ef; border: 1px solid #e4dccf; padding: 16px 18px; margin: 18px 0; }

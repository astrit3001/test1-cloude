  .lc-cfg__wa { background: #1f7a4d !important; border-color: #1f7a4d !important; color: #fff !important; }
  .lc-cfg__wa:hover { background: #17603c !important; border-color: #17603c !important; }
  .lc-cfg__form { border-top: 1px solid #e4dccf; padding-top: 4px; }

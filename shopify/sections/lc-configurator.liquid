    .lc-cfg__project > span { min-height: 170px; }
    .lc-cfg__oitems { grid-template-columns: 1fr 1fr; }
    .lc-cfg__back { padding: 10px 12px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "LC Projekt-Konfigurator",
  "settings": [
    { "type": "text", "id": "title", "label": "Überschrift", "default": "Projekt-Konfigurator" },
    { "type": "textarea", "id": "intro", "label": "Einleitung" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp-Nummer (international, z. B. 4917662596394)" },
    { "type": "url", "id": "privacy_url", "label": "Link Datenschutzerklärung" },
    { "type": "number", "id": "bath_from", "label": "Komplettbad ab (€) – derzeit nicht verwendet", "default": 20000 },
    { "type": "number", "id": "spread", "label": "Spielraum der Gesamtschätzung (%)", "default": 15 },
    { "type": "checkbox", "id": "show_3d", "label": "3D-Vorschau des Raums anzeigen", "info": "Fliesenoberfläche: Metafeld custom.textur_3d (Bild) am Produkt, sonst Produktbild mit „farbe“ im Dateinamen.", "default": true },
    { "type": "header", "content": "Verlegepreise (Schätzung)" },
    { "type": "number", "id": "lay_min", "label": "Verlegung €/m² von (nur Info)", "default": 40 },
    { "type": "number", "id": "lay_max", "label": "Verlegung Wohnen/Terrasse €/m² (wird gerechnet)", "default": 70 },
    { "type": "number", "id": "lay_bath", "label": "Verlegung Bad €/m² (wird gerechnet)", "default": 200 },

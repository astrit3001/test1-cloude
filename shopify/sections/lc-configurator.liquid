  .lc-cfg__3d-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 8px 10px; background: #fff; border-top: 1px solid #e4dccf; }
  .lc-cfg__3d-title { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #8a6a3a; font-weight: 600; margin-right: auto; }
  .lc-cfg__3d-bar button { border: 1px solid #d8cfc0; background: #fff; padding: 6px 10px; font-size: 12px; cursor: pointer; color: #1c1b19; font-family: inherit; min-width: 34px; }

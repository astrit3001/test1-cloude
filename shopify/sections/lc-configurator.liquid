        let base = mat + svSum;
        const floored = false;
        const min = r100(base);
        const max = r100(base * (1 + this.cfg.spread / 100));
        return { mat, sv, svSum, base, min, max, floored };
      }
      renderProgress() {
        this.$('[data-progress]').innerHTML = this.flow.map((k, i) => {
          const cls = (i === this.idx ? 'is-active' : i < this.idx ? 'is-done' : '') + (i <= this.maxIdx && i !== this.idx ? ' is-link' : '');
          return '<li class="' + cls + '" data-i="' + i + '"' + (i <= this.maxIdx ? ' role="button" tabindex="0"' : '') + '>' + LABELS[k] + '</li>';
        }).join('');
      }
      valid() {
        const k = this.flow[this.idx];
        if (k === 'projekt') return !!this.project();
        if (k === 'masse') return this.areas().floor > 0;
        if (k === 'fliesen') return !!this.sel.boden || this.$('[data-tile-skip]').checked;
        if (k === 'leistung') return !!this.$('input[name="lc-leistung"]:checked');
        return true;
      }
      printMeta() {
        const a = this.areas(), sl = this.isBath() && this.slope3d();
        const tile = (sel) => (sel ? esc(clean(sel.p.t)) + ' · ' + esc(this.variant(sel).t) : 'noch nicht gewählt');
        const facts = [];
        if (this.isBath()) facts.push(['Raum', fmtM(this.num('[data-m="l"]')) + ' × ' + fmtM(this.num('[data-m="b"]')) + ', Höhe ' + fmtM(this.num('[data-m="h"]') || 2.5)]);
        facts.push(['Flächen', 'Boden ' + NUM.format(a.floor) + ' m²' + (a.wall ? ' · Wand ' + NUM.format(a.wall) + ' m²' : '')]);
        if (sl) facts.push(['Dachschräge', { back: 'hinten', front: 'vorne', left: 'links', right: 'rechts' }[sl.side] + ', Kniestock ' + fmtM(sl.k) + ', reicht ' + fmtM(sl.d) + ' in den Raum']);
        facts.push(['Bodenfliese', tile(this.sel.boden)]);
        if (this.isBath()) facts.push(['Wandfliese', tile(this.sel.wand || this.sel.boden)]);
        const lay = this.room3d.layoutText(true);
        if (lay.length) facts.push(['Aufteilung', lay.map(esc).join('<br>')]);
        return { title: { komplettbad: 'Komplettbadsanierung', bad: 'Bad neu fliesen', wohnen: 'Küche & Wohnbereich', terrasse: 'Terrasse & Pool' }[this.project()] || 'Planung', facts };
      }
      slope3d() {
        const side = this.$('[data-m="slope"]').value;
        if (!side) return null;
        const h = this.num('[data-m="h"]') || 2.5;
        return { side, k: Math.min(h, this.num('[data-m="knee"]')), d: this.num('[data-m="sdepth"]') || 1.5 };
      }
      update() {
        this.querySelectorAll('[data-slope-only]').forEach((el) => { el.hidden = !this.$('[data-m="slope"]').value; });
        const a = this.areas();
        const calc = this.$('[data-calc]');
        if (a.floor > 0) {
          calc.hidden = false;
          calc.innerHTML = '<div><span>Bodenfläche</span><b>' + NUM.format(a.floor) + ' m²</b></div>' +
            (this.isBath() ? '<div><span>Wandfläche</span><b>' + NUM.format(a.wall) + ' m²</b></div>' : '') +
            '<div><span>Bedarf inkl. 10 % Verschnitt</span><b>' + (this.need(a.floor) + this.need(a.wall)) + ' m²</b></div>';
        } else calc.hidden = true;
        const e = this.estimate();
        this.$('[data-live]').innerHTML = this.project() ? '<small>Ihr aktueller Wert</small> <b data-live-v>' + EUR.format(Math.round(e.base)) + '</b>' : '';
        this.next.disabled = !this.valid();
        if (this.flow[this.idx] === 'sanitaer') this.next.textContent = Object.keys(this.sel.san).length ? 'Weiter' : 'Überspringen';
        else this.next.textContent = 'Weiter';
        this.renderSlots();
        this.sync3d();
      }
      sync3d() {
        if (!this.room3d) return;
        const show = !!this.project() && this.flow[this.idx] !== 'projekt' && this.areas().floor > 0;
        this.room3d.box.hidden = !show;
        if (show) this.room3d.set(this.scene3d());
      }
      labels(prefix) {
        const g = this.opts.find((x) => x.name.indexOf(prefix) === 0);
        return g ? (this.choice[g.name] || []).map((id) => (g.items.find((i) => i.id === id) || {}).label || '') : [];
      }
      tile3d(sel) {
        if (!sel) return null;
        const v = this.variant(sel);
        const m = String(v.t).match(/(\d+(?:[.,]\d+)?)\s*[×x]\s*(\d+(?:[.,]\d+)?)/) || String(sel.p.t).match(/(\d+(?:[.,]\d+)?)\s*[×x]\s*(\d+(?:[.,]\d+)?)/);
        const w = m ? parseFloat(m[1].replace(',', '.')) : 60, h = m ? parseFloat(m[2].replace(',', '.')) : 60;
        return { url: v.tx || sel.p.tx || sel.p.img || '', w, h, gloss: /poliert|glänzend|lappato/i.test(v.t + ' ' + sel.p.t) };
      }
      scene3d() {
        const floor = this.tile3d(this.sel.boden);
        if (this.isBath()) {
          const l = this.num('[data-m="l"]'), b = this.num('[data-m="b"]'), h = this.num('[data-m="h"]') || 2.5;
          const mode = this.$('[data-m="wall"]').value;
          return {
            l, b, h,
            wallH: mode === 'full' ? h : mode === 'half' ? 1.2 : 0,
            slope: this.slope3d(),
            floor, wall: this.tile3d(this.sel.wand),
            items: this.items3d(),
          };
        }
        const a = this.areas().floor;
        const terr = this.project() === 'terrasse';
        const l = Math.sqrt(a * (terr ? 1.6 : 1.4));
        return { l, b: a / l, h: terr ? 0 : 2.6, wallH: 0, floor, wall: null, items: [], ground: terr };
      }
      // Sanitärobjekte für die 3D-Ansicht aus Ausstattung und gewählten Produkten.
      // Solange die Ausstattung noch nicht gewählt wurde (oder bei "Bad neu fliesen"), zeigen wir ein Standardbad.
      items3d() {
        const L = (p) => this.labels(p);
        const san = Object.values(this.sel.san);
        const sanQ = (cat) => san.filter((x) => this.sanCat(x.p) === cat).reduce((n, x) => n + x.q, 0);
        const sanT = (cat) => san.filter((x) => this.sanCat(x.p) === cat).map((x) => x.p.t).join(' ');
        const decided = this.project() === 'komplettbad' && this.maxIdx >= this.flow.indexOf('ausstattung');
        const out = [];
        const wc = L('WC')[0] || (sanQ('WC') ? 'WC' : '');
        if (wc || !decided) out.push({ key: 'wc', stand: /Stand/.test(wc), dusch: /Dusch-WC/.test(wc) });
        L('WC-Extras').forEach((t) => { if (/Bidet/.test(t)) out.push({ key: 'bidet' }); if (/Urinal/.test(t)) out.push({ key: 'urinal' }); });
        const dusche = L('Dusche');
        if (dusche.length || !decided) {
          const size = (L('Duschgröße')[0] || '').match(/(\d+)\s*×\s*(\d+)/);
          out.push({
            key: 'shower', w: size ? +size[1] / 100 : 0.9, d: size ? +size[2] / 100 : 0.9,
            tray: dusche.some((t) => /Duschwanne/.test(t)) && !dusche.some((t) => /Bodengleich/.test(t)),
            drain: L('Duschablauf')[0] || '', head: L('Duschbrause')[0] || '', glass: L('Duschabtrennung')[0] || '', extras: L('Dusch-Extras'),
            niches: /Trennmauer/.test(L('Duschabtrennung')[0] || '') ? +(((L('Nischen in der Trennmauer')[0] || '').match(/\d+/) || [0])[0]) : 0,
          });
        }
        const wanne = L('Badewanne')[0] || (sanQ('Badewannen') ? (/freistehend/i.test(sanT('Badewannen')) ? 'Freistehende Badewanne' : 'Einbauwanne') : '');
        if (wanne) out.push({ key: 'tub', type: /Freistehend/.test(wanne) ? 'free' : /Whirlpool/.test(wanne) ? 'whirl' : 'built' });
        const wp = L('Waschplatz')[0] || '';
        const vq = sanQ('Waschtische') + sanQ('Badmöbel') + sanQ('Waschtischplatten');
        const licht = L('Heizung & Licht');
        if (wp || vq || !decided) out.push({ key: 'vanity', double: /Doppel/.test(wp) || sanQ('Waschtische') >= 2, led: licht.some((t) => /LED/.test(t)) });
        if (licht.some((t) => /Handtuch/.test(t))) out.push({ key: 'radiator' });
        if (licht.some((t) => /Lüfter/.test(t))) out.push({ key: 'fan' });
        return out;
      }
      go(n, force) {
        if (n < 0 || n >= this.flow.length) return;
        if (n > this.idx && !force && !this.valid()) return;
        this.idx = n;
        this.maxIdx = Math.max(this.maxIdx, n);
        const k = this.flow[n];
        this.querySelectorAll('.lc-cfg__step').forEach((s) => s.classList.toggle('is-active', s.dataset.step === k));
        this.back.hidden = n === 0;
        this.next.hidden = n === this.flow.length - 1;
        if (k === 'ausstattung') this.renderOptions('A');
        if (k === 'leistung') this.renderOptions('L');
        if (k === 'fliesen') this.renderTiles();
        if (k === 'sanitaer') this.renderSanitary();
        if (k === 'anfrage') this.summary();
        this.renderProgress();
        this.update();
        window.scrollTo({ top: this.getBoundingClientRect().top + window.scrollY - 120, behavior: 'smooth' });
      }
      renderSlots() {
        const box = this.$('[data-slots]');
        const slots = this.isBath() ? ['boden', 'wand'] : ['boden'];
        const name = { boden: this.project() === 'terrasse' ? 'Terrassenplatte' : 'Bodenfliese', wand: 'Wandfliese' };
        box.innerHTML = slots.map((sl) => {
          const sel = this.sel[sl];
          const active = this.slot === sl ? ' is-active' : '';
          if (!sel) {
            const hint = sl === 'wand' && this.sel.boden ? 'Gleiche wie Boden – hier klicken, um eine andere zu wählen' : (this.slot === sl ? 'Jetzt unten eine Fliese anklicken' : 'Hier klicken, dann Fliese wählen');
            return '<div class="lc-cfg__slot' + active + '" data-slot="' + sl + '"><div><em>' + name[sl] + '</em><span class="lc-cfg__slot-empty">' + hint + '</span></div></div>';
          }
          const v = this.variant(sel);
          const opts = sel.p.vs.map((vv) => '<option value="' + vv.id + '"' + (vv.id === v.id ? ' selected' : '') + '>' + esc(vv.t) + ' – ' + EUR2.format(vv.p / 100) + (vv.a ? '/m²' : '/Stk') + '</option>').join('');
          return '<div class="lc-cfg__slot is-filled' + active + '" data-slot="' + sl + '"><img src="' + sel.p.img + '" alt=""><div><em>' + name[sl] + '</em><strong>' + esc(clean(sel.p.t)) + '</strong>' +
            (sel.p.vs.length > 1 ? '<select data-variant="' + sl + '">' + opts + '</select>' : '<span>' + EUR2.format(v.p / 100) + (v.a ? '/m²' : '/Stk') + '</span>') +
            '</div><button type="button" class="lc-cfg__x" data-clear="' + sl + '" aria-label="Entfernen">×</button></div>';
        }).join('');
        box.querySelectorAll('[data-slot]').forEach((el) => el.addEventListener('click', (e) => {
          if (e.target.closest('select, button')) return;
          this.slot = el.dataset.slot; this.renderSlots();
        }));
        box.querySelectorAll('[data-variant]').forEach((el) => el.addEventListener('change', (e) => {
          e.stopPropagation(); this.sel[el.dataset.variant].vid = parseInt(el.value, 10); this.update();
        }));
        box.querySelectorAll('[data-clear]').forEach((el) => el.addEventListener('click', () => {
          this.sel[el.dataset.clear] = null; this.slot = el.dataset.clear; this.renderTiles(); this.update();
        }));
      }
      renderTiles() {
        const cats = ['Alle'].concat([...new Set(this.tiles.map((p) => p.c))].filter((c) => c !== 'Outdoor' || this.project() === 'terrasse'));
        const f = this.$('[data-tile-filter]');
        f.innerHTML = cats.map((c) => '<button type="button" class="' + (c === this.tileFilter ? 'is-active' : '') + '" data-c="' + esc(c) + '">' + esc(short(c)) + '</button>').join('');
        f.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { this.tileFilter = b.dataset.c; this.renderTiles(); }));
        const list = this.tiles.filter((p) => this.tileFilter === 'Alle' ? (p.c !== 'Outdoor' || this.project() === 'terrasse') : p.c === this.tileFilter);
        const chosen = [this.sel.boden, this.sel.wand].filter(Boolean).map((x) => x.p.id);
        const grid = this.$('[data-tile-grid]');
        grid.innerHTML = list.map((p) => {
          const min = Math.min.apply(null, p.vs.map((v) => v.p));
          const area = p.vs.some((v) => v.a);
          return '<button type="button" class="lc-cfg__prod' + (chosen.indexOf(p.id) > -1 ? ' is-selected' : '') + '" data-tile="' + p.id + '">' +
            '<span class="lc-cfg__prod-img">' + (p.img ? '<img loading="lazy" src="' + p.img + '" alt="">' : '') + '</span>' +
            '<span class="lc-cfg__prod-v">' + esc(p.v) + '</span><span class="lc-cfg__prod-t">' + esc(clean(p.t)) + '</span>' +
            '<span class="lc-cfg__prod-p">' + (p.vs.length > 1 ? 'ab ' : '') + EUR2.format(min / 100) + (area ? '/m²' : '/Stk') + '</span></button>';
        }).join('') || '<p class="lc-cfg__sub">Keine Produkte in dieser Kategorie.</p>';
        grid.querySelectorAll('[data-tile]').forEach((b) => b.addEventListener('click', () => {
          const p = this.tiles.find((x) => x.id === parseInt(b.dataset.tile, 10));
          const v = p.vs.find((vv) => vv.ok) || p.vs[0];
          this.sel[this.slot] = { p, vid: v.id };
          this.$('[data-tile-skip]').checked = false;
          if (this.isBath() && this.slot === 'boden' && !this.sel.wand) this.slot = 'wand';
          this.renderTiles(); this.update();
          this.$('[data-slots]').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }));
      }
      sanCat(p) { return SAN_TYPE[p.pt] || SAN_CATS.find((c) => p.tags.indexOf(c) > -1) || 'Zubehör'; }
      renderSanitary() {
        const grid = this.$('[data-san-grid]');
        const cats = ['Alle'].concat(SAN_CATS.filter((c) => this.sanitary.some((p) => this.sanCat(p) === c)));
        const f = this.$('[data-san-filter]');
        f.innerHTML = cats.map((c) => '<button type="button" class="' + (c === this.sanFilter ? 'is-active' : '') + '" data-c="' + c + '">' + c + '</button>').join('');
        f.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => { this.sanFilter = b.dataset.c; this.renderSanitary(); }));
        const list = this.sanitary.filter((p) => this.sanFilter === 'Alle' || this.sanCat(p) === this.sanFilter);
        grid.innerHTML = list.map((p) => {
          const s = this.sel.san[p.id];
          const min = Math.min.apply(null, p.vs.map((v) => v.p));
          const opts = p.vs.length > 1 ? '<select data-svar="' + p.id + '">' + p.vs.map((v) => '<option value="' + v.id + '"' + (s && s.vid === v.id ? ' selected' : '') + '>' + esc(v.t) + ' – ' + EUR2.format(v.p / 100) + '</option>').join('') + '</select>' : '';
          return '<div class="lc-cfg__prod lc-cfg__prod--san' + (s ? ' is-selected' : '') + '">' +
            '<span class="lc-cfg__prod-img">' + (p.img ? '<img loading="lazy" src="' + p.img + '" alt="">' : '') + '</span>' +
            '<span class="lc-cfg__prod-v">' + esc(this.sanCat(p)) + '</span><span class="lc-cfg__prod-t">' + esc(p.t) + '</span>' +
            '<span class="lc-cfg__prod-p">' + (p.vs.length > 1 ? 'ab ' : '') + EUR2.format(min / 100) + '</span>' + (s ? opts : '') +
            '<span class="lc-cfg__qty">' + (s ? '<button type="button" data-q="-1" data-id="' + p.id + '">−</button><b>' + s.q + '</b><button type="button" data-q="1" data-id="' + p.id + '">+</button>' : '<button type="button" class="lc-cfg__add" data-q="1" data-id="' + p.id + '">Hinzufügen</button>') + '</span></div>';
        }).join('');
        grid.querySelectorAll('[data-q]').forEach((b) => b.addEventListener('click', () => {
          const id = parseInt(b.dataset.id, 10);
          const p = this.sanitary.find((x) => x.id === id);
          const cur = this.sel.san[id] || { p, vid: p.vs[0].id, q: 0 };
          cur.q += parseInt(b.dataset.q, 10);
          if (cur.q <= 0) delete this.sel.san[id]; else this.sel.san[id] = cur;
          this.renderSanitary(); this.update();
        }));
        grid.querySelectorAll('[data-svar]').forEach((el) => el.addEventListener('change', () => { this.sel.san[el.dataset.svar].vid = parseInt(el.value, 10); this.update(); }));
      }
      summary() {
        const a = this.areas();
        const lines = this.lines();
        const total = this.total();
        const est = this.estimate();
        const leistung = (this.$('input[name="lc-leistung"]:checked') || {}).value || '';
        const projName = { komplettbad: 'Komplettbadsanierung', bad: 'Bad neu fliesen', wohnen: 'Küche & Wohnbereich', terrasse: 'Terrasse & Pool' }[this.project()] || '';
        this.$('[data-bathnote]').hidden = this.project() !== 'komplettbad';
        let html = '<div class="lc-cfg__estimate"><span>Geschätzte Gesamtkosten</span><b>' + range(est.min, est.max) + '</b><small>Unverbindliche Schätzung inkl. MwSt. – der verbindliche Preis folgt nach Besichtigung bzw. anhand Ihrer Fotos.</small></div>';
        html += '<dl class="lc-cfg__facts"><div><dt>Projekt</dt><dd>' + projName + '</dd></div><div><dt>Fläche</dt><dd>Boden ' + NUM.format(a.floor) + ' m²' + (a.wall ? ' · Wand ' + NUM.format(a.wall) + ' m²' : '') + '</dd></div><div><dt>Leistung</dt><dd>' + esc(leistung) + '</dd></div></dl>';
        html += '<h4>Material</h4>';
        if (lines.length) {
          html += '<table class="lc-cfg__table"><thead><tr><th>Position</th><th>Menge</th><th>Preis</th><th>Summe</th></tr></thead><tbody>' +
            lines.map((l) => '<tr><td><small>' + l.label + '</small>' + esc(l.title) + (l.vt ? '<br><small>' + esc(l.vt) + '</small>' : '') + '</td><td>' + (l.area ? l.qty + ' m²' : (l.qty ? l.qty + ' Stk' : 'nach Plan')) + '</td><td>' + EUR2.format(l.price / 100) + (l.area ? '/m²' : '/Stk') + '</td><td>' + (l.sum ? EUR2.format(l.sum / 100) : '–') + '</td></tr>').join('') +
            '</tbody><tfoot><tr><td colspan="3">Material (exakt, inkl. MwSt.)</td><td>' + EUR2.format(total / 100) + '</td></tr></tfoot></table>';
        } else {
          html += '<p class="lc-cfg__sub">Noch keine Produkte gewählt – wir beraten Sie gern.</p>';
        }
        if (est.sv.length) {
          html += '<h4>Ausstattung, Installation & Verlegung (Schätzung)</h4><table class="lc-cfg__table lc-cfg__table--sv"><tbody>' +
            est.sv.map((s) => '<tr><td>' + esc(s.label) + '<br><small>' + esc(s.detail) + '</small></td><td>ca. ' + EUR.format(Math.round(s.sum)) + '</td></tr>').join('') +
            '</tbody><tfoot><tr><td>Arbeitsleistungen & Ausstattung</td><td>ca. ' + EUR.format(Math.round(est.svSum)) + '</td></tr></tfoot></table>';
        }
        html += '<p class="lc-cfg__note">Die Gesamtschätzung enthält ' + this.cfg.spread + ' % Spielraum. Fliesenmengen inkl. ca. 10 % Verschnitt. XXL-Platten zzgl. Spezialtransport. Ausstattungspreise sind Richtwerte inkl. Montage und Standard-Material.</p>';
        this.$('[data-summary]').innerHTML = html;
        const svText = est.sv.map((s) => '- ' + s.label + ' (' + s.detail + '): ca. ' + EUR.format(Math.round(s.sum))).join('\n');
        const layout = this.room3d && this.isBath() ? this.room3d.layoutText() : [];
        const sl = this.isBath() && this.slope3d();
        const text = 'Projekt: ' + projName + '\nBoden: ' + NUM.format(a.floor) + ' m²' + (a.wall ? ', Wand: ' + NUM.format(a.wall) + ' m²' : '') +
          (sl ? '\nDachschräge: ' + { back: 'hinten', front: 'vorne', left: 'links', right: 'rechts' }[sl.side] + ', Kniestock ' + fmtM(sl.k) + ', reicht ' + fmtM(sl.d) + ' in den Raum' : '') +
          '\nLeistung: ' + leistung + '\n' +
          (lines.length ? 'Material:\n' + lines.map((l) => '- ' + l.label + ': ' + l.title + (l.vt ? ' (' + l.vt + ')' : '') + (l.area ? ', ' + l.qty + ' m²' : (l.qty ? ', ' + l.qty + ' Stk' : '')) + (l.sum ? ' = ' + EUR2.format(l.sum / 100) : '')).join('\n') + '\n' : '') +
          (svText ? 'Ausstattung & Leistungen:\n' + svText + '\n' : '') +
          (layout.length ? 'Aufteilung laut 3D-Vorschau:\n' + layout.map((t) => '- ' + t).join('\n') + '\n' : '') +
          'Geschätzt gesamt: ' + range(est.min, est.max);
        this.$('[data-f="config"]').value = text;
        this.$('[data-f="total"]').value = range(est.min, est.max);
        const wa = this.$('[data-wa-link]');
        if (wa) wa.href = 'https://wa.me/' + this.dataset.wa + '?text=' + encodeURIComponent('Guten Tag, hier meine Konfiguration von lunaceram.com:\n' + text + '\nProjektort/PLZ: \nFotos hänge ich an.');
        this.$('[data-cart]').hidden = !lines.some((l) => l.qty > 0);
      }
      async addToCart() {
        const items = this.lines().filter((l) => l.qty > 0).map((l) => ({ id: l.vid, quantity: l.qty }));
        if (!items.length) return;
        const btn = this.$('[data-cart]');
        btn.disabled = true; btn.textContent = 'Wird hinzugefügt …';
        try {
          const r = await fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items }) });
          if (!r.ok) throw new Error('cart');
          window.location.href = '/cart';
        } catch (e) {
          btn.disabled = false; btn.textContent = 'Material in den Warenkorb';
          alert('Einige Artikel konnten nicht hinzugefügt werden. Bitte fragen Sie das Angebot an.');
        }
      }
    });
  }
{% endjavascript %}

{% stylesheet %}
  .lc-cfg__intro { text-align: center; max-width: 720px; margin: -10px auto 24px; color: #6f675c; font-size: 15px; line-height: 1.6; }
  .lc-cfg { display: block; background: #fff; border: 1px solid #e4dccf; border-top: 2px solid #b8955a; border-radius: 4px; padding: 28px clamp(14px, 3.5vw, 40px) 22px; max-width: 1160px; margin: 0 auto; }
  .lc-cfg__progress { display: flex; gap: 6px; list-style: none; padding: 0; margin: 0 0 24px; }
  .lc-cfg__progress li { flex: 1; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #9a9184; padding-top: 10px; border-top: 3px solid #e4dccf; user-select: none; }
  .lc-cfg__progress li.is-active { color: #111; border-color: #111; font-weight: 700; }
  .lc-cfg__progress li.is-done { color: #8a6a3a; border-color: #b8955a; }
  .lc-cfg__progress li.is-link { cursor: pointer; }
  .lc-cfg__progress li.is-link:hover, .lc-cfg__progress li.is-link:focus-visible { color: #111; border-color: #111; outline: none; text-decoration: underline; text-underline-offset: 4px; }
  .lc-cfg__summary-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .lc-cfg__summary-head h3 { margin: 0; }
  .lc-cfg__change { background: #fff; border: 2px solid #111; color: #111; padding: 9px 16px; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; font-family: inherit; }
  .lc-cfg__change:hover { background: #111; color: #fff; }
  .lc-cfg__summary-head + .lc-cfg__sub { margin: 8px 0 16px; }
  .lc-cfg__step { display: none; }
  .lc-cfg__step.is-active { display: block; animation: lcFade .3s ease; }
  @keyframes lcFade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .lc-cfg h3 { font-size: clamp(22px, 2.6vw, 28px); margin: 0 0 16px; color: #111; }
  .lc-cfg h4 { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; margin: 22px 0 10px; color: #8a6a3a; font-family: inherit; font-weight: 600; }
  .lc-cfg__sub { color: #6f675c; font-size: 14px; margin: -8px 0 14px; }
  .lc-cfg__projects { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 12px; }
  @media (max-width: 989px) { .lc-cfg__projects { grid-template-columns: 1fr 1fr; } .lc-cfg__project--hero { grid-column: 1 / -1; } }
  .lc-cfg__project { position: relative; cursor: pointer; }
  .lc-cfg__project input { position: absolute; opacity: 0; pointer-events: none; }
  .lc-cfg__project > span { position: relative; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px; min-height: 220px; padding: 16px; border-radius: 4px; overflow: hidden; color: #fff; background: #222; border: 2px solid transparent; transition: border-color .2s; }
  .lc-cfg__project img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; transition: transform .5s; }
  .lc-cfg__project > span::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,.82), rgba(0,0,0,.1) 70%); z-index: 1; }
  .lc-cfg__project strong, .lc-cfg__project small, .lc-cfg__project b, .lc-cfg__project em { position: relative; z-index: 2; }
  .lc-cfg__project strong { font-family: var(--lc-serif, serif); font-weight: 400; font-size: 21px; line-height: 1.15; }
  .lc-cfg__project small { font-size: 13px; color: #e9e1d6; }
  .lc-cfg__project:hover img { transform: scale(1.04); }
  .lc-cfg__project input:checked + span { border-color: #b8955a; box-shadow: 0 0 0 3px rgba(184,149,90,.35); }
  .lc-cfg__project--hero > span { min-height: 260px; }
  .lc-cfg__project--hero strong { font-size: 27px; }
  .lc-cfg__badge { align-self: flex-start; font-style: normal; font-size: 10px; letter-spacing: .18em; text-transform: uppercase; background: #b8955a; color: #111; padding: 5px 8px; margin-bottom: auto; }
  .lc-cfg__from { font-family: inherit; font-weight: 600; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: #d4b47a; margin-top: 8px; }
  .lc-cfg__options { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 10px; }
  .lc-cfg__options--two { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .lc-cfg__opt { position: relative; cursor: pointer; }
  .lc-cfg__opt input { position: absolute; opacity: 0; pointer-events: none; }
  .lc-cfg__opt span { display: flex; flex-direction: column; justify-content: center; min-height: 64px; padding: 12px 14px; border: 1px solid #d8cfc0; border-radius: 2px; background: #f7f4ef; font-size: 15px; color: #1c1b19; transition: all .15s ease; }
  .lc-cfg__opt span small { color: #6f675c; font-size: 12px; margin-top: 2px; }
  .lc-cfg__opt--big span { min-height: 92px; gap: 4px; }
  .lc-cfg__opt--big strong { font-size: 17px; }
  .lc-cfg__opt:hover span { border-color: #b8955a; }
  .lc-cfg__opt input:checked + span { background: #111; border-color: #111; color: #fff; }
  .lc-cfg__opt input:checked + span small { color: #d4b47a; }
  .lc-cfg__row, .lc-cfg__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
  .lc-cfg__row--4 { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
  .lc-cfg__row--slope { margin-top: 12px; }
  .lc-print { display: none; }
  @media print {
    html, body { background: #fff !important; }
    body > *:not(.lc-print) { display: none !important; }
    .lc-print { display: block; font-family: Arial, sans-serif; color: #111; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .lc-print section { break-after: page; page-break-after: always; }
    .lc-print section:last-child { break-after: auto; page-break-after: auto; }
    .lc-print header { display: flex; justify-content: space-between; border-bottom: 2px solid #b8955a; padding-bottom: 4px; margin-bottom: 8px; font-size: 11px; }
    .lc-print h1 { font-size: 20px; margin: 4px 0 8px; }
    .lc-print h2 { font-size: 11px; margin: 10px 0 4px; text-transform: uppercase; letter-spacing: .12em; color: #8a6a3a; }
    .lc-print dl { display: grid; grid-template-columns: 110px 1fr; gap: 2px 10px; font-size: 10.5px; margin: 0 0 8px; }
    .lc-print dt { color: #8a6a3a; }
    .lc-print dd { margin: 0; }
    .lc-print img { display: block; width: 100%; max-height: 90mm; object-fit: contain; border: 1px solid #ddd; }
    .lc-print svg { display: block; width: 100%; height: auto; }
    .lc-print__floor svg { max-height: 105mm; }
    .lc-print__floor--small svg { max-height: 60mm; }
    .lc-print__walls { display: grid; grid-template-columns: 1fr 1fr; gap: 5mm; }
    .lc-print__walls svg { max-height: 60mm; }
    .lc-print figure { margin: 0; break-inside: avoid; }
    .lc-print figcaption { font-size: 10px; font-weight: 700; margin-bottom: 2px; }
    .lc-print table { width: 100%; border-collapse: collapse; font-size: 9px; margin-top: 6px; }
    .lc-print th, .lc-print td { border-bottom: 1px solid #ddd; padding: 3px 4px; text-align: left; vertical-align: top; }
    .lc-print__note, .lc-print__legend { font-size: 9px; color: #555; }
    .lc-print__legend i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin: 0 3px 0 8px; vertical-align: -1px; }
    .lc-print__legend i.sq { border-radius: 0; }
    @page { size: A4; margin: 12mm; }
  }
  .lc-cfg__field[hidden] { display: none; }
  .lc-cfg__field { display: flex; flex-direction: column; gap: 5px; font-size: 13px; color: #6f675c; }
  .lc-cfg__field--full { margin-top: 12px; }
  .lc-cfg__field input, .lc-cfg__field textarea, .lc-cfg__field select, .lc-cfg__slot select, .lc-cfg__prod select { border: 1px solid #d8cfc0; border-radius: 2px; padding: 10px 12px; font-size: 16px; background: #fff; color: #111; font-family: inherit; width: 100%; box-sizing: border-box; }
  .lc-cfg__calc { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1px; background: #e4dccf; border: 1px solid #e4dccf; margin-top: 16px; }
  .lc-cfg__calc div { background: #f7f4ef; padding: 12px 14px; display: flex; flex-direction: column; gap: 2px; }
  .lc-cfg__calc span { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #8a6a3a; }
  .lc-cfg__calc b { font-family: var(--lc-serif, serif); font-weight: 400; font-size: 24px; color: #111; }
  .lc-cfg__slots { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px; margin-bottom: 16px; }
  .lc-cfg__slot { position: relative; display: flex; gap: 12px; align-items: center; padding: 10px 30px 10px 12px; border: 1px dashed #c9bfae; background: #f7f4ef; cursor: pointer; min-height: 76px; }
  .lc-cfg__slot.is-active { border: 2px solid #111; }
  .lc-cfg__slot.is-filled { border-style: solid; background: #fff; }
  .lc-cfg__slot img { width: 56px; height: 56px; object-fit: cover; flex: none; }
  .lc-cfg__slot > div { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .lc-cfg__slot em { font-style: normal; font-size: 10px; letter-spacing: .16em; text-transform: uppercase; color: #8a6a3a; }
  .lc-cfg__slot strong { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lc-cfg__slot select { padding: 6px 8px; font-size: 13px; }
  .lc-cfg__slot-empty { color: #6f675c; font-size: 13px; }
  .lc-cfg__x { position: absolute; top: 4px; right: 6px; background: none; border: 0; font-size: 18px; color: #6f675c; cursor: pointer; }
  .lc-cfg__chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .lc-cfg__chips button { border: 1px solid #d8cfc0; background: #fff; padding: 7px 12px; font-size: 13px; cursor: pointer; color: #1c1b19; font-family: inherit; }
  .lc-cfg__chips button.is-active { background: #111; color: #fff; border-color: #111; }
  .lc-cfg__grid-products { display: grid; grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); gap: 12px; max-height: 620px; overflow-y: auto; padding: 2px 4px 4px 2px; }

  .lc-cfg__actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .lc-cfg__cartbtn { border-color: #111 !important; }
  .lc-cfg__ok { background: #edf7ee; border-left: 3px solid #2e7d32; padding: 12px 14px; color: #1b5e20; }
  .lc-cfg__err { background: #fdecea; border-left: 3px solid #b3261e; padding: 12px 14px; color: #8c1d18; }
  .lc-cfg__nav { position: sticky; bottom: 0; z-index: 3; display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 22px calc(-1 * clamp(14px, 3.5vw, 40px)) -22px; padding: 12px clamp(14px, 3.5vw, 40px); background: rgba(255,255,255,.97); border-top: 1px solid #e4dccf; box-shadow: 0 -6px 16px rgba(0,0,0,.05); }
  .lc-cfg__back { background: #fff; border: 2px solid #111; color: #111; font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; cursor: pointer; padding: 10px 16px; font-family: inherit; }
  .lc-cfg__back:hover { background: #111; color: #fff; }
  .lc-cfg__live { font-weight: 600; font-size: 15px; color: #111; margin-left: auto; }
  .lc-cfg__next:disabled { opacity: .35; cursor: not-allowed; }
  .lc-cfg__ogroup { border: 0; padding: 0; margin: 0 0 18px; }
  .lc-cfg__ogroup legend { font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: #8a6a3a; font-weight: 600; margin-bottom: 8px; padding: 0; }
  .lc-cfg__ogroup legend i { font-style: normal; text-transform: none; letter-spacing: 0; color: #9a9184; font-weight: 400; }
  .lc-cfg__oitems { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; }

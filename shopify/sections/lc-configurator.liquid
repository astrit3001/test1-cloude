  .lc-cfg__prod:hover { border-color: #b8955a; }
  .lc-cfg__prod.is-selected { border: 2px solid #111; box-shadow: 0 0 0 3px rgba(184,149,90,.35); }
  .lc-cfg__prod-img { display: block; aspect-ratio: 1; background: #f7f4ef; overflow: hidden; margin-bottom: 6px; }
  .lc-cfg__prod-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lc-cfg__prod-v, .lc-cfg__prod-t, .lc-cfg__prod-p, .lc-cfg__prod select, .lc-cfg__qty { margin: 0 10px; }

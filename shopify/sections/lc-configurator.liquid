{%- liquid
  assign s = section.settings
  assign wa = s.whatsapp | remove: '+' | remove: ' '
-%}
<section id="konfigurator" class="lc-section lc-cfg-section" style="padding-top: {{ s.padding_top }}px; padding-bottom: {{ s.padding_bottom }}px;">
  <div class="lc-wrap">
    {%- if s.title != blank -%}<div class="lc-heading"><h2>{{ s.title }}</h2></div>{%- endif -%}
    {%- if s.intro != blank -%}<p class="lc-cfg__intro">{{ s.intro }}</p>{%- endif -%}

    <lc-configurator class="lc-cfg" data-wa="{{ wa }}" data-lay-min="{{ s.lay_min }}" data-lay-max="{{ s.lay_max }}" data-xxl-min="{{ s.xxl_min }}" data-xxl-max="{{ s.xxl_max }}" data-lay-bath="{{ s.lay_bath | default: 200 }}" data-bath-from="{{ s.bath_from }}" data-spread="{{ s.spread | default: 15 }}">
      <script type="text/plain" data-options>{{ s.options }}
{{ s.options_extra }}</script>
      {%- comment -%} Jede Fliese in einem eigenen Block: ein fehlerhaftes Produkt legt nicht die ganze Auswahl lahm {%- endcomment -%}
      {%- for i in (1..5) -%}
        {%- assign key = 'col_tiles_' | append: i -%}
        {%- assign col = s[key] -%}
        {%- if col != blank -%}
          {%- for p in col.products limit: s.per_collection -%}
            <script type="application/json" data-tile-json>{%- render 'lc-cfg-tile-json', p: p, c: col.title -%}</script>
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if s.col_outdoor != blank -%}
        {%- for p in s.col_outdoor.products limit: s.per_collection -%}
          <script type="application/json" data-tile-json>{%- render 'lc-cfg-tile-json', p: p, c: 'Outdoor' -%}</script>
        {%- endfor -%}
      {%- endif -%}
      <script type="application/json" data-sanitary>
        [
        {%- if s.col_sanitary != blank -%}
          {%- paginate s.col_sanitary.products by 100 -%}
          {%- for p in s.col_sanitary.products -%}
            {"id":{{ p.id }},"t":{{ p.title | json }},"v":{{ p.vendor | json }},"u":{{ p.url | json }},"tags":{{ p.tags | json }},"pt":{{ p.type | json }},"img":{{ p.featured_image | image_url: width: 400 | json }},"vs":[
              {%- for v in p.variants limit: 20 -%}{"id":{{ v.id }},"t":{{ v.title | json }},"p":{{ v.price }},"ok":{{ v.available }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
            ]}{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
          {%- endpaginate -%}
        {%- endif -%}
        ]
      </script>

      <ol class="lc-cfg__progress" data-progress></ol>

      {%- if s.show_3d -%}
        <div class="lc-cfg__3d" data-3d hidden>
          <div class="lc-cfg__3d-stage" data-3d-stage>
            <span class="lc-cfg__3d-hint" data-3d-hint>3D-Vorschau wird geladen …</span>
          </div>
          <div class="lc-cfg__3d-bar">
            <span class="lc-cfg__3d-title">Ansicht</span>
            <button type="button" data-3d-zoom="1" aria-label="Näher heran">+</button>
            <button type="button" data-3d-zoom="-1" aria-label="Weiter weg">−</button>
            <button type="button" class="lc-cfg__3d-mode" data-3d-mode>2D-Grundriss</button>
            <button type="button" data-3d-dims aria-pressed="true">Maße</button>
            <button type="button" data-3d-zones aria-pressed="false">Schutzbereiche</button>
            <button type="button" data-3d-move aria-pressed="false">Objekte verschieben</button>
            <button type="button" data-3d-save>Als Bild speichern</button>
          </div>
          <div class="lc-cfg__3d-bar">
            <span class="lc-cfg__3d-title">Planung</span>
            <button type="button" class="lc-cfg__3d-mode" data-3d-auto>Automatisch planen</button>
            <button type="button" data-3d-extra="door" aria-pressed="true">Tür</button>
            <button type="button" data-3d-extra="window" aria-pressed="false">Fenster</button>
            <button type="button" data-3d-walls aria-pressed="false">Wandfliesen anpassen</button>
            <button type="button" data-3d-snap aria-pressed="true">Fugenraster</button>
            <button type="button" data-3d-reset>Zurücksetzen</button>
            <button type="button" class="lc-cfg__3d-mode" data-3d-print>Pläne drucken</button>
          </div>
          <ul class="lc-cfg__3d-check" data-3d-check></ul>
          <p class="lc-cfg__3d-note">Dusche, WC, Waschtisch & Co. lassen sich frei im Raum verschieben (nahe der Wand rasten sie ein) – Maße und Aufteilung werden mit Ihrer Anfrage übermittelt. Vereinfachte Darstellung nach Ihren Maßen und im echten Fliesenformat, Sanitärobjekte symbolisch. Farbe und Struktur können je nach Bildschirm abweichen – Muster sehen Sie in unserer Ausstellung.</p>
        </div>
      {%- endif -%}

      <div class="lc-cfg__step is-active" data-step="projekt">
        <h3>Was planen Sie?</h3>
        <div class="lc-cfg__projects">
          <label class="lc-cfg__project lc-cfg__project--hero">
            <input type="radio" name="lc-projekt" value="komplettbad" data-bath>
            <span>
              {%- if s.img_komplett != blank -%}{{ s.img_komplett | image_url: width: 900 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
              <em class="lc-cfg__badge">Rundum-sorglos</em>
              <strong>Komplettbadsanierung</strong>
              <small>Alles neu: Rückbau, Sanitär, Installation, Fliesen & Verlegung</small>
              <b class="lc-cfg__from">Jetzt planen &rarr;</b>
            </span>
          </label>
          <label class="lc-cfg__project">
            <input type="radio" name="lc-projekt" value="bad" data-bath>
            <span>{%- if s.img_bad != blank -%}{{ s.img_bad | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}<strong>Bad neu fliesen</strong><small>Nur Boden- & Wandfliesen, auf Wunsch mit Verlegung – ohne Umbau</small></span>
          </label>
          <label class="lc-cfg__project">
            <input type="radio" name="lc-projekt" value="wohnen">
            <span>{%- if s.img_wohnen != blank -%}{{ s.img_wohnen | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}<strong>Küche & Wohnbereich</strong><small>Bodenfliesen, Großformate</small></span>
          </label>
          <label class="lc-cfg__project">
            <input type="radio" name="lc-projekt" value="terrasse">
            <span>{%- if s.img_terrasse != blank -%}{{ s.img_terrasse | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}<strong>Terrasse & Pool</strong><small>2 cm Terrassenplatten</small></span>
          </label>
        </div>
      </div>

      <div class="lc-cfg__step" data-step="masse">
        <h3>Wie groß ist die Fläche?</h3>
        <div data-bath-only>
          <div class="lc-cfg__row lc-cfg__row--4">
            <label class="lc-cfg__field"><span>Länge (m)</span><input type="number" min="0.5" step="0.05" inputmode="decimal" placeholder="z. B. 3,0" data-m="l"></label>
            <label class="lc-cfg__field"><span>Breite (m)</span><input type="number" min="0.5" step="0.05" inputmode="decimal" placeholder="z. B. 2,5" data-m="b"></label>
            <label class="lc-cfg__field"><span>Raumhöhe (m)</span><input type="number" min="1.8" step="0.05" inputmode="decimal" value="2.50" data-m="h"></label>
            <label class="lc-cfg__field"><span>Wandfliesen</span>
              <select data-m="wall"><option value="full">raumhoch</option><option value="half">halbhoch (1,20 m)</option><option value="sockel">nur Sockel (8 cm)</option><option value="none">keine Wandfliesen</option></select>
            </label>
          </div>
          <div class="lc-cfg__row lc-cfg__row--4 lc-cfg__row--slope">
            <label class="lc-cfg__field"><span>Dachschräge (Seite wie in der 3D-Ansicht)</span>
              <select data-m="slope"><option value="">keine Dachschräge</option><option value="back">ja – hinten</option><option value="front">ja – vorne</option><option value="left">ja – links</option><option value="right">ja – rechts</option></select>
            </label>
            <label class="lc-cfg__field" data-slope-only hidden><span>Kniestock – Wandhöhe an der Schräge (m)</span><input type="number" min="0" step="0.05" inputmode="decimal" value="1.00" data-m="knee"></label>
            <label class="lc-cfg__field" data-slope-only hidden><span>Schräge reicht in den Raum (m)</span><input type="number" min="0.2" step="0.05" inputmode="decimal" value="1.50" data-m="sdepth"></label>
          </div>
        </div>
        <div data-area-only>
          <div class="lc-cfg__row">
            <label class="lc-cfg__field"><span>Fläche in m²</span><input type="number" min="1" step="0.5" inputmode="decimal" placeholder="z. B. 30" data-m="area"></label>
          </div>
        </div>
        <div class="lc-cfg__calc" data-calc hidden></div>
      </div>

      <div class="lc-cfg__step" data-step="ausstattung">
        <h3>Ausstattung & Sanitärarbeiten</h3>
        <p class="lc-cfg__sub">Was soll in Ihr neues Bad? Die Preise sind Richtwerte inkl. Montage – Sie sehen die Schätzung unten sofort.</p>
        <div data-opt-a></div>
      </div>

      <div class="lc-cfg__step" data-step="fliesen">
        <h3>Wählen Sie Ihre Fliese</h3>
        <div class="lc-cfg__slots" data-slots></div>
        <div class="lc-cfg__chips" data-tile-filter></div>
        <div class="lc-cfg__grid-products" data-tile-grid></div>
        <label class="lc-cfg__skip"><input type="checkbox" data-tile-skip> Ich möchte mich zur Fliesenauswahl beraten lassen</label>
      </div>

      <div class="lc-cfg__step" data-step="sanitaer">
        <h3>Waschtisch, Badewanne, WC & Badmöbel von Ilbagno (APE Grupo)</h3>
        <p class="lc-cfg__sub">Wählen Sie konkrete Produkte – oder überspringen Sie diesen Schritt.</p>
        <div class="lc-cfg__chips" data-san-filter></div>
        <div class="lc-cfg__grid-products" data-san-grid></div>
      </div>

      <div class="lc-cfg__step" data-step="leistung">
        <h3>Was dürfen wir übernehmen?</h3>
        <div class="lc-cfg__options lc-cfg__options--two">
          <label class="lc-cfg__opt lc-cfg__opt--big"><input type="radio" name="lc-leistung" value="Material + Verlegung durch Unik Fliesen"><span><strong>Material + Verlegung</strong><small>Fachgerecht verlegt von Unik Fliesen – inkl. Verfugung & Silikonfugen. Ein Ansprechpartner von der Planung bis zur Übergabe.</small></span></label>
          <label class="lc-cfg__opt lc-cfg__opt--big"><input type="radio" name="lc-leistung" value="Nur Material"><span><strong>Nur Material</strong><small>Lieferung, Verlegung organisiere ich selbst</small></span></label>
        </div>
        <h4>Vorarbeiten, Heizung & Extras</h4>
        <div data-opt-l></div>
      </div>

      <div class="lc-cfg__step" data-step="anfrage">
        <div class="lc-cfg__summary-head">
          <h3>Ihre Übersicht</h3>
          <button type="button" class="lc-cfg__change" data-goto="0">Auswahl ändern</button>
        </div>
        <p class="lc-cfg__sub">Tipp: Oben auf einen Schritt klicken, um ihn direkt zu ändern – Ihre Eingaben bleiben erhalten.</p>
        <div class="lc-cfg__bathnote" data-bathnote hidden>
          <strong>Komplettbadsanierung</strong>
          <span>Alles aus einer Hand: Material, Sanitär, Installation und Verlegung. Den genauen Preis erhalten Sie nach Besichtigung bzw. anhand Ihrer Fotos.</span>
        </div>
        <div class="lc-cfg__summary" data-summary></div>

        <div class="lc-cfg__photos">
          <strong>Fotos von Ihrem Bad / Ihrer Fläche</strong>
          <p>Mit Fotos können wir Ihr Angebot deutlich genauer kalkulieren. Senden Sie uns Ihre Konfiguration per WhatsApp und hängen Sie die Fotos direkt im Chat an.</p>
          {%- if wa != blank -%}<a class="lc-btn lc-cfg__wa" data-wa-link href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">Konfiguration + Fotos per WhatsApp senden</a>{%- endif -%}
        </div>

        {%- form 'contact', class: 'lc-cfg__form', id: 'LcConfiguratorForm' -%}
          {%- if form.posted_successfully? -%}
            <p class="lc-cfg__ok">Vielen Dank! Ihre Anfrage ist bei uns eingegangen – wir melden uns schnellstmöglich.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="lc-cfg__err">Bitte prüfen Sie Ihre Angaben: {{ form.errors | default_errors }}</p>
          {%- endif -%}
          <h4>Oder Angebot per E-Mail anfordern</h4>
          <input type="hidden" name="contact[Konfiguration]" data-f="config">
          <input type="hidden" name="contact[Geschätzte Kosten]" data-f="total">
          <div class="lc-cfg__grid">
            <label class="lc-cfg__field"><span>Name *</span><input type="text" name="contact[name]" autocomplete="name" required></label>
            <label class="lc-cfg__field"><span>E-Mail *</span><input type="email" name="contact[email]" autocomplete="email" required></label>
            <label class="lc-cfg__field"><span>Telefon</span><input type="tel" name="contact[phone]" autocomplete="tel"></label>
            <label class="lc-cfg__field"><span>PLZ / Projektort *</span><input type="text" name="contact[PLZ Projektort]" autocomplete="postal-code" required></label>
            <label class="lc-cfg__field"><span>Gewünschter Zeitraum</span><input type="text" name="contact[Zeitraum]" placeholder="z. B. Frühjahr 2027"></label>
          </div>
          <label class="lc-cfg__field lc-cfg__field--full"><span>Nachricht</span><textarea name="contact[body]" rows="3" placeholder="Untergrund, Besonderheiten, Wünsche …"></textarea></label>
          <label class="lc-cfg__consent"><input type="checkbox" required> <span>Ich bin einverstanden, dass meine Angaben zur Bearbeitung der Anfrage verwendet werden. Hinweise in der <a href="{{ s.privacy_url | default: '/policies/privacy-policy' }}">Datenschutzerklärung</a>.</span></label>
          <div class="lc-cfg__actions">
            <button type="submit" class="lc-btn">Angebot anfordern</button>
            <button type="button" class="lc-btn lc-btn--light lc-cfg__cartbtn" data-cart hidden>Material in den Warenkorb</button>
          </div>
        {%- endform -%}
      </div>

      <div class="lc-cfg__nav">
        <button type="button" class="lc-cfg__back" data-back hidden>&larr; Zurück</button>
        <span class="lc-cfg__live" data-live></span>
        <button type="button" class="lc-btn lc-cfg__next" data-next disabled>Weiter</button>
      </div>
    </lc-configurator>
  </div>
</section>

{% javascript %}
  if (!customElements.get('lc-configurator')) {
    const EUR = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const EUR2 = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' });
    const NUM = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 2 });
    const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    const clean = (t) => String(t).replace(/\s*[–-]\s*Preis pro (m²|m2|Stück)\s*$/i, '');
    const short = (c) => String(c).split(' – ')[0].replace(/^Fliesen in /, '').replace('Beton- & Zementoptik', 'Betonoptik');
    const range = (a, b) => (a === b ? EUR.format(a) : EUR.format(a) + ' – ' + EUR.format(b));
    const r100 = (v) => Math.round(v / 100) * 100;
    const SAN_CATS = ['Waschtische', 'Badewannen', 'WC', 'Badmöbel', 'Armaturen', 'Spiegel', 'Waschtischplatten', 'Zubehör'];
    const SAN_TYPE = { Waschbecken: 'Waschtische', Aufsatzwaschbecken: 'Waschtische', Standwaschbecken: 'Waschtische', 'Sanitär': 'Waschtische', Badewanne: 'Badewannen', Badewannen: 'Badewannen', 'WC-Komplettset': 'WC', 'Badmöbel': 'Badmöbel', 'Badmöbel-Set': 'Badmöbel', Armaturen: 'Armaturen', Spiegel: 'Spiegel', Waschtischplatten: 'Waschtischplatten', 'Zubehör': 'Zubehör' };
    const LABELS = { projekt: 'Projekt', masse: 'Maße', ausstattung: 'Ausstattung', fliesen: 'Fliesen', sanitaer: 'Sanitär', leistung: 'Leistung', anfrage: 'Übersicht' };
    const UNIT = { pauschal: '', m2_boden: '/m² Boden', m2_wand: '/m² Wand', m2_fliesen: '/m² Fliesenfläche', m2_rest: '/m² Wand ohne Fliesen', m2_decke: '/m² Decke' };
    const THREE_URL = 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.min.js';
    let threeLoad = null;

    // 3D-Raum (Puppenhaus-Ansicht): Wände zeigen nach innen und werden von außen ausgeblendet,
    // Fliesen werden als 2×2-Block (gespiegelt, gegen sichtbare Wiederholung) im echten Format gekachelt.
    // Sanitärobjekte hängen an einer Wand (wall + pos = Mitte entlang der Wand) und lassen sich verschieben.
    const ITEM_NAMES = { wc: 'WC', bidet: 'Bidet', urinal: 'Urinal', shower: 'Dusche', tub: 'Badewanne', vanity: 'Waschtisch', radiator: 'Handtuchheizkörper', fan: 'Lüfter', door: 'Tür', window: 'Fenster' };
    const WALL_NAMES = { back: 'Rückwand', front: 'Vorderwand', left: 'linke Wand', right: 'rechte Wand' };
    const CONN_COLORS = { KW: '#1f6fd1', WW: '#d12f2f', MW: '#8a3fd1', AW: '#555555', HZ: '#c2185b', E: '#e09a00' };
    const CONN_NAMES = { KW: 'Kaltwasser', WW: 'Warmwasser', MW: 'Mischwasser', AW: 'Abwasser', HZ: 'Heizung', E: 'Elektro' };
    const JOINT_TXT = { ok: 'Fugen laufen in den Boden durch', near: 'Fugen laufen fast durch (wenige mm Versatz)', no: 'Fugen laufen nicht durch', shift: 'Raster an Armatur ausgerichtet' };
    const fmtM = (v) => Math.max(0, v).toFixed(2).replace('.', ',') + ' m';
    const cm = (v) => Math.round(v * 1000) / 10;
    const cmT = (v) => String(cm(v)).replace('.', ',');
    const GROUT = 0.2; // Fugenbreite in cm
    const SOCKEL = 0.08; // Sockelhöhe in m
    const MODES = ['full', 'half', 'sockel', 'none'];
    const MODE_NAMES = { full: 'raumhoch', half: 'halbhoch (1,20 m)', sockel: 'nur Sockel (8 cm)', none: 'ohne Fliesen' };
    // Bewegungsflächen & Abstände für die automatische Planung (Richtwerte; VDI 6000: 80 × 75 cm vor dem WC)
    const PLAN = { shower: { side: 0, front: 0.75 }, tub: { side: 0, front: 0.75 }, wc: { side: 0.2, front: 0.75 }, bidet: { side: 0.2, front: 0.75 }, urinal: { side: 0.2, front: 0.75 }, vanity: { side: 0.05, front: 0.75 }, radiator: { side: 0.05, front: 0 }, fan: { side: 0, front: 0 } };
    // Symmetrische Verlegung: Abstand der ersten Fuge vom Wandanfang, so dass beide Randstücke gleich und möglichst groß sind
    const tileStart = (len, t) => {
      const m = (v) => ((v % t) + t) % t;
      const a = m(len / 2), b = m(len / 2 - t / 2);
      return (a < 0.001 ? t : a) >= (b < 0.001 ? t : b) ? a : b;
    };
    // Deckenhöhe an Punkt (x, z): bei Dachschräge steigt sie vom Kniestock k über die Tiefe d bis zur Raumhöhe
    const ceilY = (s, x, z) => {
      const sl = s.slope;
      if (!sl) return s.h;
      const dist = { back: z, front: s.b - z, left: x, right: s.l - x }[sl.side];
      return Math.min(s.h, sl.k + ((s.h - sl.k) * dist) / Math.max(0.01, sl.d));
    };
    // Wände: [Länge, Mitte x, Mitte z, Drehung, Punkt entlang der Wand (u ab Wandmitte) -> [x, z]]; Normale zeigt in den Raum
    const wallDefs = (s) => [
      [s.l, s.l / 2, 0, 0, (u) => [s.l / 2 + u, 0], 'back'],
      [s.l, s.l / 2, s.b, Math.PI, (u) => [s.l / 2 - u, s.b], 'front'],
      [s.b, 0, s.b / 2, Math.PI / 2, (u) => [0, s.b / 2 - u], 'left'],
      [s.b, s.l, s.b / 2, -Math.PI / 2, (u) => [s.l, s.b / 2 + u], 'right'],
    ];
    // Geflieste Wandfläche bis Höhe wh, unter einer Dachschräge entsprechend weniger
    const wallArea = (s, wh) => wallDefs(s).reduce((sum, [len, , , , at]) => {
      const n = 60;
      let a = 0;
      for (let i = 0; i < n; i++) { const p = at(-len / 2 + ((i + 0.5) * len) / n); a += (Math.min(wh, ceilY(s, p[0], p[1])) * len) / n; }
      return sum + a;
    }, 0);
    class LcRoom3D {
      constructor(box) {
        this.box = box;
        this.stage = box.querySelector('[data-3d-stage]');
        this.hint = box.querySelector('[data-3d-hint]');
        this.moveBtn = box.querySelector('[data-3d-move]');
        this.tex = {};
        this.key = '';
        this.items = [];
        this.place = {};
        this.moveMode = false;
        this.showDims = true;
        this.active = null;
        this.view = { theta: -0.65, phi: 1.0, zoom: 1 };
        this.mode = '3d';
        const modeBtn = box.querySelector('[data-3d-mode]');
        modeBtn.addEventListener('click', () => {
          this.mode = this.mode === '3d' ? '2d' : '3d';
          modeBtn.textContent = this.mode === '3d' ? '2D-Grundriss' : '3D-Ansicht';
          this.box.classList.toggle('is-2d', this.mode === '2d');
          if (this.persp) this.camera = this.mode === '2d' ? this.ortho : this.persp;
          this.hint.hidden = false;
          this.hint.textContent = this.mode === '2d' ? 'Grundriss von oben · Objekte ziehen zum Verschieben' : 'Ziehen zum Drehen';
          this.render();
        });
        this.extra = { door: true, window: false };
        this.snapOn = true;
        this.wallMode = {};
        this.editWalls = false;
        const wallsBtn = box.querySelector('[data-3d-walls]');
        wallsBtn.addEventListener('click', () => {
          this.editWalls = !this.editWalls;
          wallsBtn.setAttribute('aria-pressed', this.editWalls);
          this.hint.hidden = false;
          this.hint.textContent = this.editWalls ? 'Wand anklicken: raumhoch → halbhoch → nur Sockel → ohne Fliesen' : 'Ziehen zum Drehen';
        });
        this.showZones = false;
        const zonesBtn = box.querySelector('[data-3d-zones]');
        zonesBtn.addEventListener('click', () => {
          this.showZones = !this.showZones;
          zonesBtn.setAttribute('aria-pressed', this.showZones);

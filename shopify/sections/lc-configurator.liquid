  .lc-cfg__estimate small { color: #6f675c; font-size: 13px; }
  .lc-cfg__live small { font-weight: 400; color: #8a6a3a; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; margin-right: 4px; }
